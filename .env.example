# Variable NAMES only. Copy to .env (git-ignored) and fill in real values locally.
# Never commit real values.

# --- Web (browser-safe, NEXT_PUBLIC_ values are visible to users) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API (server only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GROQ_API_KEY=

# --- Worker (Modal secrets, server only) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
